---
export const prerender = true;
import Layout from "../layouts/Layout.astro";

import Linkedin from "../icons/Social/Linkedin.astro";
import Github from "../icons/Social/Github.astro";
import GitLab from "../icons/Social/GitLab.astro";
import Social_icons from "../components/Social_icons.astro";
import Gmail from "../icons/Social/Gmail.astro";
import Section from "../components/Section.astro";
import Section_techno from "../components/Section_techno.astro";
import Technology from "../components/Technology.astro";
import Code from "../icons/Titres/Code.astro";
import Project from "../components/Project.astro";

import Formation from "../components/Formation.astro";
import About from "../components/About.astro";
import Cert_icon from "../icons/Titres/Cert_icon.astro";

import My_icons from "../icons/Titres/My_icon.astro";
import Section_about from "../components/Section_about.astro";
import Footer from "../components/Footer.astro";
import Section_formation from "../components/Section_formation.astro";

import ContactSection from "../components/ContactSection.astro";
import ResumeLinks from "../components/ResumeLinks.astro";



// import ProjectMotion from "../components/ProjectMotion.astro";

// import { Vortex } from "../components/Vortex.tsx";

import data from "../data/data.json";
import { getProfileAge } from '../lib/profile-age.mjs';
---

<Layout
    title={`${data.user.name} — Développeur web PHP / Symfony et Astro`}
    description="Développeur web PHP / Symfony et Astro à Nantes. Découvrez mon parcours dans le développement web et les télécommunications, mes projets et mon CV."
>
    <main id="top">
        <Section>
            <div class="profile-intro">
                <h1
                    class="profile-name font-bold"
                >
                    {data.user.name}
                </h1>
                <div class="profile-content">
                    <h2
                        class="profile-role"
                    >
                        {data.user.function}
                    </h2>
                    <p class="profile-summary">{data.user.introduction}</p>

                    <div class="profile-grid">
                        <div class="profile-identity">
                            <div class="flex items-center">
                                <div class="flex justify-center align-middle">
                                    <img src={`/${data.user.img}`} srcset={data.user.imgSrcSet} sizes="224px" width="224" height="224" loading="eager" fetchpriority="high" alt="Fabien Roy" class="profile-portrait rounded-full object-cover" />
                                </div>
                            </div>
                            <div
                                class="profile-details"
                            >
                                <p><strong>Nom :</strong> {data.user.name}</p>
                                <p>
                                    <strong>Âge :</strong>
                                    <span id="profile-age">{getProfileAge()}</span> ans
                                </p>
                                <p>
                                    <strong>Téléphone :</strong>
                                    {data.user.phone}
                                </p>
                                <p>
                                    <strong>Email :</strong>
                                    <a
                                        href={"mailto:" + data.user.email}
                                        class="hover:underline"
                                        >{data.user.email}</a
                                    >
                                </p>
                                <p>
                                    <strong>Adresse :</strong>
                                    {data.user.address}
                                </p>
                            </div>
                        </div>
                        <div
                            class="profile-cv"
                        >
                            <ResumeLinks />
                        </div>
                    </div>
                </div>
                <nav
                    class="profile-socials"
                    aria-label="Profils et contact"
                >
                    <Social_icons href={data.user.linkedin}>
                        <Linkedin class="size-4 md:size-6" />
                        Linkedin
                    </Social_icons>
                    <Social_icons href={data.user.github}>
                        <Github class="size-4 md:size-6" />
                        GitHub
                    </Social_icons>
                    <Social_icons href="https://gitlab.com/users/fabienroy2">
                        <GitLab class="size-4 md:size-6" />
                        GitLab
                    </Social_icons>
                    <Social_icons href={"mailto:" + data.user.email}>
                        <Gmail class="size-4 md:size-6" />
                        {data.user.email}
                    </Social_icons>
                </nav>
            </div>
        </Section>

        <Section_techno id="technology">
            <Technology technologies={data.technologies} />
        </Section_techno>
        <Section id="project">
            <div class="flex justify-center">
                <h2
                    class="text-4xl font-semibold pb-10 flex gap-x-3 items-center text-center mb-4 text-light-primary dark:text-dark-primary"
                >
                    <Code class="size-8" />Mes Projets
                </h2>
            </div>
            <Project projects={data.projects} />
        </Section>
        <!-- <Section id="projectMotion">
            <div class="flex justify-center">
                <h2 class="text-4xl font-semibold pb-10 flex gap-x-3 items-center text-center mb-4 text-light-primary dark:text-dark-primary">
                    Mes Projets
                </h2>
            </div>
            <ProjectMotion projects={data.projects} />
        </Section> -->
        <Section_formation id="formation" class="px-4">
            <div class="flex justify-center">
                <h2
                    class="text-4xl font-semibold pb-10 flex gap-x-3 items-center text-center mb-4 text-light-primary dark:text-dark-primary"
                >
                    <Cert_icon class="size-8" />Parcours de formation
                </h2>
            </div>
            <Formation formations={data.formations} />
        </Section_formation>
        <Section_about id="about" class="px-4">
            <div class="flex justify-center">
                <h2
                    class="text-4xl font-semibold pb-10 flex gap-x-3 items-center text-center mb-4 text-light-primary dark:text-dark-primary"
                >
                    <My_icons class="size-8" />À propos de moi
                </h2>
            </div>
            <About about={data.user.about} />
        </Section_about>
        <ContactSection />

        <Footer />
    </main>
</Layout>

<style>
    .profile-intro { display: flex; flex-direction: column; align-items: center; gap: 2rem; max-width: 1000px; margin: auto; }
    .profile-name { font-size: clamp(2.5rem, 5vw, 3.5rem); line-height: 1.1; text-align: center; }
    .profile-content { width: 100%; }
    .profile-role { text-align: center; font-size: clamp(1.25rem, 3vw, 1.9rem); line-height: 1.5; margin-bottom: .75rem; }
    .profile-summary { max-width: 65ch; margin: 0 auto 2.5rem; text-align: center; line-height: 1.75; }
    .profile-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2.5rem; align-items: center; }
    .profile-identity { display: flex; flex-direction: column; align-items: center; gap: 1.5rem; }
    .profile-portrait { width: 224px; height: 224px; }
    .profile-details { font-size: 1rem; line-height: 1.8; }
    .profile-details p + p { margin-top: .35rem; }
    .profile-details a { text-underline-offset: .2em; overflow-wrap: anywhere; }
    .profile-cv { min-width: 0; }
    .profile-socials { display: flex; flex-wrap: wrap; justify-content: center; gap: .65rem; width: 100%; min-width: 0; }
    @media (min-width: 768px) {
        .profile-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 3.5rem; }
        .profile-summary { margin-bottom: 3rem; }
    }
</style>

<script>
    import { getProfileAge } from '../lib/profile-age.mjs';

    const updateProfileAge = () => {
        const age = document.getElementById('profile-age');
        if (age) age.textContent = String(getProfileAge());
    };
    updateProfileAge();
    window.addEventListener('pageshow', updateProfileAge);
    document.addEventListener('visibilitychange', () => {
        if (!document.hidden) updateProfileAge();
    });
    // Also refresh a page kept open through the birthday, without rebuilding it.
    window.setInterval(updateProfileAge, 60_000);
</script>
