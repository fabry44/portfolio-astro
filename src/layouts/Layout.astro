---
export const prerender = true;
import Header from "../components/Header.astro";
import "@fontsource-variable/source-code-pro";


interface Props {
    title: string;
    description: string;
}

const { description, title } = Astro.props;
---

<!doctype html>
<html lang="fr" class="light">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/Logo_fr.png" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <link rel="sitemap" href="/sitemap-index.xml" />
        <!-- <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:wght@700&family=Scada:wght@400&display=swap" rel="stylesheet"> -->

        <script>
            (function () {
                const theme = localStorage.getItem("theme");
                if (theme === "dark") {
                    document.documentElement.classList.add("dark");
                }
            })();
        </script>
    </head>
    <body
        class="bg-background text-text dark:bg-dark-background dark:text-dark-text"
    >
        <div class="background"></div>
        <Header />
        <slot />
    </body>
</html>

<style is:global>
    @import url("https://fonts.googleapis.com/css?family=Crimson%20Pro:700|Scada:400");
    /* @font-face {
    font-family: 'Crimson Pro';
    src: url('/fonts/CrimsonPro-Regular.woff2') format('woff2'),
         url('/fonts/CrimsonPro-Regular.woff') format('woff');
    font-weight: 700;
    font-display: swap;
}

@font-face {
    font-family: 'Scada';
    src: url('/fonts/Scada-Regular.woff2') format('woff2'),
         url('/fonts/Scada-Regular.woff') format('woff');
    font-weight: 400;
    font-display: swap;
} */
    h1,
    h2,
    h3,
    h4,
    h5 {
        font-family: "Crimson Pro", sans-serif;
        font-weight: 700;
    }

    html {
        font-size: 100%; /* 16px */
        font-family: "Scada", sans-serif;
        font-weight: 400;
        /* scroll-behavior: smooth; */
        scroll-padding-top: 7rem;
    }

    body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        width: 100%;
        transition: background 0.3s ease;
        line-height: 1.65;
    }

    @tailwind base;
    @tailwind components;
    @tailwind utilities;

    @layer base {
        :root {
            --text: #050606;
            --background: #fcfcfc;
            --primary: #ebeae5;
            --secondary: #d9d6d3;
            --accent: #847c71;
            --line: rgba(132, 124, 113, 0.3);
            --shadow-panel: 0 3px 12px rgba(5, 6, 6, 0.07);
        }
        .dark {
            --text: #f9fafa;
            --background: #272727;
            --primary: #ebeae5;
            --secondary: #d6d3c5;
            --accent: #d6d3c5;
            --line: rgba(214, 211, 197, 0.25);
            --shadow-panel: 0 4px 16px rgba(0, 0, 0, 0.18);
        }
    }

    header {
        background: var(--background);
        border-bottom: 1px solid var(--line);
        transition: background 0.2s ease;
        z-index: 10;
    }

    header.scrolled {
        background: var(--background);
        box-shadow: var(--shadow-panel);
        width: 100%;
        z-index: 10;
        transition:
            background 0.3s ease,
            filter 0.3s ease,
            height 0.3s ease,
            border-radius 0.8s ease;
    }

    #toggle-dark-mode {
        background: var(--background);
        width: 44px;
        height: 44px;
        flex-shrink: 0;
        border-radius: 50%;
        transition: background 0.15s ease, border-color 0.15s ease;
        font-size: 20px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    @media screen and (min-width: 576px) {
        header.scrolled {
            background: var(--background);
            /* color: white; */
            transition:
                background 0.3s ease,
                filter 0.3s ease,
                height 0.3s ease,
                border-radius 0.8s ease;
        }
    }

    @media screen and (min-width: 768px) {
        header.scrolled {
            background: var(--background);
            transition:
                background 0.3s ease,
                filter 0.3s ease,
                height 0.3s ease,
                border-radius 0.8s ease;
        }
    }

    .background {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -10;
        background: radial-gradient(
            circle 200px at 50% 200px,
            #e3effd,
            transparent
        );
        filter: blur(100px);
    }

    .bg-section {
        background-image: url("/contact_fond_3.webp"); /* image à remplacer une fois dispo */
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;

        padding: 3rem 1rem;
        height: 1200px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    @media screen and (min-width: 768px) {
        .bg-section {
            height: 800px;
            padding: 6rem;
        }
    }

    /* .bg-section::before {
        content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.2);
    z-index: 1;
    backdrop-filter: blur(1px);
    } */

    .bg-section > .flex {
        z-index: 1;
    }

    .technoIcon {
        background: var(--secondary);
        border: 1px solid transparent;
        border-radius: 8px;
        color: #050606;
    }
    .ProjectCard {
        background: var(--primary);
        color: #050606;
        border: 1px solid var(--line);
        border-radius: 12px;
        box-shadow: var(--shadow-panel);
    }

    .project-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem; max-width: 1080px; margin: auto; }
    .project-card { display: flex; flex-direction: column; min-width: 0; height: 100%; padding: 1.25rem; }
    .project-image { aspect-ratio: 16 / 10; overflow: hidden; border-radius: 7px; background: var(--secondary); }
    .project-title { font-size: 1.4rem; line-height: 1.3; margin: 1.25rem 0 1rem; text-wrap: balance; }
    .project-tags { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.1rem; }
    .project-tag { display: inline-flex; align-items: center; padding: .2rem .55rem; border-radius: 5px; font-size: .75rem; line-height: 1.5; }
    .project-description { margin-bottom: 1rem; }
    .project-description summary { cursor: pointer; min-height: 44px; display: list-item; align-content: center; font-weight: 600; }
    .project-description > div { padding: .75rem 0; font-size: .95rem; line-height: 1.7; }
    .project-actions { display: flex; flex-wrap: wrap; gap: 1rem; padding-top: .75rem; border-top: 1px solid rgba(132,124,113,.3); margin-top: auto; }
    .project-actions a { display: inline-flex; align-items: center; min-height: 44px; gap: .4rem; text-decoration: underline; text-underline-offset: .25em; }
    .project-actions svg { width: 16px; height: 16px; }
    .social-link { display: inline-flex; align-items: center; justify-content: center; min-width: 0; max-width: 100%; min-height: 44px; gap: .5rem; padding: .45rem .8rem; border: 1px solid var(--line); border-radius: 7px; color: var(--text); font-size: .95rem; transition: background .15s ease; }
    .social-link:hover { background: var(--secondary); color: #050606; }
    .social-link svg { width: 20px; height: 20px; flex-shrink: 0; }
    main { overflow-wrap: anywhere; }
    .about-copy { max-width: 70ch; margin: auto; font-size: 1.05rem; line-height: 1.8; }
    .about-copy p + p { margin-top: 1.2rem; }
    main > section, main > section[id] { scroll-margin-top: 7rem; }
    main > section { padding-top: clamp(2.5rem, 5vw, 4.5rem); padding-bottom: clamp(2.5rem, 5vw, 4.5rem); }
    main > section > div > h2, main > section > h2 { font-size: clamp(1.9rem, 4vw, 2.5rem); line-height: 1.25; }
    @media (min-width: 768px) { .project-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (hover: hover) { .project-actions a:hover { text-decoration-thickness: 2px; } }

    /* .contactsection {
        background: var(--secondary);
        border-radius: 15px;
        padding: 30px;
        
    } */

    #contactForm {
        background: var(--secondary);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: clamp(1.25rem, 3vw, 2rem);
        box-shadow: var(--shadow-panel);
    }

    input::placeholder,
    textarea::placeholder {
        color: grey;
    }

    .sectionFormation {
        max-width: 800px;
    }
    .divFormation {
        margin-left: 45%;
    }

    /* .classPair {
        width: 50%;
    } */
    .classImpair {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        text-align: end;
        padding-right: 50px;
        margin-left: -100%;
        width: 100%;
    }

    @media (max-width: 767px) {
        .divFormation { margin-left: 0; padding-left: 1.25rem; }
        .classImpair { align-items: flex-start; text-align: left; padding-right: 0; margin-left: 0; }
    }
    .sectionFooter {
        background: var(--background);
        border-top: 1px solid var(--line);
        min-height: 180px;
        display: flex;
        z-index: 10;
    }

    @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: 0.01ms !important;
        }
        html {
            scroll-behavior: auto;
        }
    }

    :focus-visible { outline: 3px solid #3973ac; outline-offset: 4px; }

    .dark #contactForm { color: #050606; }

    .curriculum {
        display: flex;
        margin-top: 20px;
        background: var(--accent);
        height: 345px;
        width: 190px;
        flex-direction: column;
        border-radius: 48px;
        justify-content: space-around;
        align-items: center;
        box-shadow: 2px 2px 4px black;
    }

    .curriculum body {
        font-family: "Lato", Helvetica, Arial, sans-serif;
        font-weight: 400;
        background: black;
        margin: 0;
        letter-spacing: 0.3px;
        color: #39424b;
        position: absolute;
        overflow: hidden;
    }

    iframe {
        position: absolute;
        background-color: var(--accent);
        color: white;
        border-radius: 15px;
        box-shadow: 3px -5px 12px 2px black;
    }

    .cta {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        min-height: 44px;
        line-height: 1.4;
        text-align: center;
        background: var(--background);
        border-radius: 8px;
        border: 1px solid var(--accent);
        color: var(--text);
        transition: background 0.15s ease, border-color 0.15s ease;
    }

    .cta:hover:not(:disabled) {
        background: var(--primary);
        color: #050606;
    }

    .shadowstyle {
        box-shadow: none;
    }

    /* arcticle > div {
            width: 100%;
            height: 800px;
            margin: 20px;
            background: #f5f5f5;
            overflow: hidden;
        }

        arcticle img {
            width: 300px;
            height: 400px;
        }

        .progress {
            position: fixed;
            left: 0;
            right: 0;
            height: 5px;
            background: #4ff0b7;
            bottom: 50px;
            transform: scaleX(0);
        } */
</style>
